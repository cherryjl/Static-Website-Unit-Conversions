{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unit Converter",
  "version": "1.1.1",
  "identifier": "com.jlcherry.unit-converter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Unit Converter",
        "width": 800,
        "height": 600,
        "minWidth": 325,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/Revolving-Arrows-x32.png",
      "icons/Revolving-Arrows-x128.png",
      "icons/Revolving-Arrows-x256.png",
      "icons/Revolving-Arrows-x512.png",
      "icons/Revolving-Arrows.ico",
      "icons/icon.icns"
    ]
  }
}
